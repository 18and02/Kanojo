# Copy to backend/.env or set these variables in PowerShell before starting.

# LM Studio: http://127.0.0.1:1234/v1
# Ollama:    http://127.0.0.1:11434/v1
# llama.cpp: http://127.0.0.1:8080/v1
KANOJO_LLM_BASE_URL=
KANOJO_LLM_MODEL=qwen3-14b
KANOJO_LLM_API_KEY=
KANOJO_LLM_TIMEOUT=60

# hybrid uses LLM extraction when available, then falls back to heuristic.
# heuristic stays fully offline.
KANOJO_MEMORY_EXTRACTION=hybrid

# Local Windows SAPI TTS service, used by scripts/start_tts.ps1.
# Leave blank to use desktop speechSynthesis fallback only.
KANOJO_TTS_BASE_URL=
KANOJO_LOCAL_TTS_VOICE=
KANOJO_LOCAL_TTS_RATE=0
KANOJO_LOCAL_TTS_VOLUME=100
KANOJO_LOCAL_TTS_TIMEOUT=60

# OpenAI-compatible audio transcription endpoint.
# Example: http://127.0.0.1:9000/v1
KANOJO_STT_BASE_URL=
KANOJO_STT_MODEL=whisper-1
KANOJO_STT_API_KEY=
KANOJO_STT_TIMEOUT=120

# Local faster-whisper STT service, used by scripts/start_stt.ps1.
KANOJO_LOCAL_STT_MODEL=base
KANOJO_LOCAL_STT_DEVICE=cpu
KANOJO_LOCAL_STT_COMPUTE_TYPE=int8
KANOJO_LOCAL_STT_LANGUAGE=zh
KANOJO_LOCAL_STT_BEAM_SIZE=5
KANOJO_LOCAL_STT_VAD=true
# Optional in mainland China: faster-whisper downloads models through Hugging Face.
HF_ENDPOINT=https://hf-mirror.com

KANOJO_DB_PATH=data/kanojo.db
KANOJO_QUIET_START=23
KANOJO_QUIET_END=8
KANOJO_PROACTIVE_COOLDOWN=120
